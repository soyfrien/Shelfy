{
  "ConnectionStrings": {
    "ShelfyDb": "Host=localhost;Port=5432;Database=shelfy;Username=shelfy;Password=shelfy_local_dev"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Recognition": {
    "WorkerEnabled": true,
    "MaxAttempts": 4,
    "BackoffBaseSeconds": 30,
    "BackoffMaxSeconds": 900,
    "LeaseMinutes": 10,
    "ProcessingTimeoutMinutes": 8,
    "PollIntervalSeconds": 5,
    "MinMatchScore": 0.72,
    "MaxSpinesPerPhoto": 150,
    "OcrProvider": "Auto"
  },
  "Storage": {
    "Provider": "Local",
    "LocalPath": "data/photos"
  },
  "AzureVision": {
    "Endpoint": "",
    "Key": "",
    "ApiVersion": "2023-10-01",
    "TimeoutSeconds": 60
  },
  "Resolution": {
    "UserAgent": "Shelfy/1.0 (+https://github.com/soyfrien/Shelfy)",
    "GoogleBooksApiKey": "",
    "TimeoutSeconds": 10,
    "MaxRetries": 2,
    "RetryBaseDelayMilliseconds": 500,
    "OpenLibraryEnabled": true,
    "GoogleBooksEnabled": true
  }
}
