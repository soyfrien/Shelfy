[Unit]
Description=Shelfy API (ASP.NET Core 8)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=shelfy
Group=shelfy
WorkingDirectory=/opt/shelfy
# Framework-dependent publish; runtime installed under /opt/dotnet-shelfy via dotnet-install.sh
ExecStart=/opt/dotnet-shelfy/dotnet /opt/shelfy/Shelfy.Api.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Root-only file (chmod 600) containing: ConnectionStrings__ShelfyDb=Host=localhost;Port=5432;Database=shelfy;Username=shelfy;Password=<PASSWORD>
EnvironmentFile=/etc/shelfy/shelfy.env
Restart=on-failure
RestartSec=5
MemoryMax=300M
MemoryHigh=250M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
